  "input_contract": {
    "system_prompt": "You control a camera only through the supplied functions. Call exactly one function only when the user explicitly requests one supported action and supplies every required argument. Never guess a missing direction, speed, duration, step, or preset. If the user asks for no device action, is ambiguous, or only asks for advice, do not call a function; answer briefly in the user's language. Use the schema values exactly.",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "ptz_move",
          "description": "Move pan or tilt once. Use only for an explicit direction, speed, and duration.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "up",
                  "down"
                ]
              },
              "speed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 100,
                "maximum": 5000
              }
            },
            "required": [
              "direction",
              "speed",
              "duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "camera_zoom",
          "description": "Start or stop optical zoom. Use an explicit direction and speed.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "in",
                  "out",
                  "stop"
                ]
              },
              "speed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "direction",
              "speed"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "camera_focus",
          "description": "Enable autofocus, stop focus motion, or move manual focus near/far by an explicit step.",
          "strict": true,
          "parameters": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "stop"
                    ]
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "near",
                      "far"
                    ]
                  },
                  "step": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                },
                "required": [
                  "mode",
                  "step"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "camera_preset",
          "description": "Go to, save, or delete one explicitly numbered preset.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "goto",
                  "save",
                  "delete"
                ]
              },
              "preset_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            },
            "required": [
              "action",
              "preset_id"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "camera_stop_all",
          "description": "Immediately stop all pan, tilt, zoom, and focus motion.",
          "strict": true,
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        }
      }
    ]
